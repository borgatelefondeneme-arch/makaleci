{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "default": "paper",
      "type": "string",
      "enum": [
        "paper",
        "topic"
      ]
    },
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "abstract": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "affiliations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "affiliations"
        ],
        "additionalProperties": false
      }
    },
    "institutions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "venue": {
      "type": [
        "string",
        "null"
      ]
    },
    "doi": {
      "type": [
        "string",
        "null"
      ]
    },
    "url": {
      "type": "string"
    },
    "fullTextUrl": {
      "type": [
        "string",
        "null"
      ]
    },
    "license": {
      "type": [
        "string",
        "null"
      ]
    },
    "publishedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "isPreprint": {
      "type": "boolean"
    },
    "peerReviewStatus": {
      "type": "string",
      "enum": [
        "peer_reviewed",
        "preprint",
        "unknown"
      ]
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fetchedAt": {
      "type": "string"
    }
  },
  "required": [
    "kind",
    "id",
    "title",
    "abstract",
    "authors",
    "institutions",
    "venue",
    "doi",
    "url",
    "fullTextUrl",
    "license",
    "publishedAt",
    "isPreprint",
    "peerReviewStatus",
    "categories",
    "sources",
    "fetchedAt"
  ],
  "additionalProperties": false
}
