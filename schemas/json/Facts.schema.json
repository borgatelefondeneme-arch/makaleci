{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "paperId": {
      "type": "string"
    },
    "basis": {
      "type": "string",
      "enum": [
        "full_text",
        "abstract_only"
      ]
    },
    "institutions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "publisher",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "number",
              "claim",
              "meta"
            ]
          },
          "statement": {
            "type": "string"
          },
          "numbers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "quote": {
            "type": "string"
          },
          "location": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "statement",
          "numbers",
          "quote",
          "location"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "paperId",
    "basis",
    "institutions",
    "sources",
    "facts"
  ],
  "additionalProperties": false
}
