    {
      "label": "Nakarat",
      "start": 20.02,
      "end": 33.03,
      "lines": [
        {
          "text": "Füzyon, füzyon; yıldızın gücü!",
          "start": 20.17,
          "end": 23.24
        },
        {
          "text": "Çekim bastırır, basınç iter",
          "start": 23.24,
          "end": 26.32
        },
        {
          "text": "Denge sürdükçe yıldız parlar",
          "start": 26.32,
          "end": 29.39
        },
        {
          "text": "Güneş de bir yıldız, bize en yakın",
          "start": 29.39,
          "end": 33.03
        }
      ]
    },
    {
      "label": "Kıta",
      "start": 33.03,
      "end": 48.04,
      "lines": [
        {
          "text": "Küçükler sönünce beyaz cüce kalır",
          "start": 33.18,
          "end": 37.26
        },
        {
          "text": "Devler patlar, süpernova olur",
          "start": 37.26,
          "end": 40.75
        },
        {
          "text": "Karbon, oksijen, demir saçılır",
          "start": 40.75,
          "end": 44.25
        },
        {
          "text": "Yeni yıldızlara malzeme olur",
          "start": 44.25,
          "end": 48.04
        }
      ]
    },
    {
