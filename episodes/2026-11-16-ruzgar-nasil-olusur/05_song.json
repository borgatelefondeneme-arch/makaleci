    {
      "label": "Nakarat",
      "start": 20.02,
      "end": 33.03,
      "lines": [
        {
          "text": "Es rüzgâr, es, görünmez koşucu!",
          "start": 20.17,
          "end": 23.45
        },
        {
          "text": "Gündüz denizden, gece karadan",
          "start": 23.45,
          "end": 26.73
        },
        {
          "text": "Ekvator ısınır, kutuplar üşür",
          "start": 26.73,
          "end": 30.29
        },
        {
          "text": "Dünya döner, yollar sapar",
          "start": 30.29,
          "end": 33.03
        }
      ]
    },
    {
      "label": "Kıta",
      "start": 33.03,
      "end": 48.04,
      "lines": [
        {
          "text": "Alize doğudan, batı rüzgârı batıdan",
          "start": 33.18,
          "end": 37.66
        },
        {
          "text": "Jet akımı yükseklerde hızlı",
          "start": 37.66,
          "end": 41.03
        },
        {
          "text": "Beaufort sıfırdan on ikiye sayar",
          "start": 41.03,
          "end": 45.23
        },
        {
          "text": "Türbin döner, ışık yanar",
          "start": 45.23,
          "end": 48.04
        }
