          "end": 36.89
        },
        {
          "text": "Turuncu desen: beni yeme der",
          "start": 36.89,
          "end": 40.61
        },
        {
          "text": "Göçmen kuşak Meksika'ya uçar",
          "start": 40.61,
          "end": 44.32
        },
        {
          "text": "Kuşaklar boyu yolculuk sürer",
