      "start": 20.02,
      "end": 33.03,
      "lines": [
        {
          "text": "Yumurta, tırtıl, krizalit, kelebek!",
          "start": 20.17,
          "end": 23.51
        },
        {
          "text": "Tam başkalaşım, büyük değişim",
          "start": 23.51,
          "end": 26.6
