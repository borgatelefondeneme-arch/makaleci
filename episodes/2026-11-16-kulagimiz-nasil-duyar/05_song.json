    {
      "label": "Nakarat",
      "start": 20.02,
      "end": 33.03,
      "lines": [
        {
          "text": "Duy, duy, dünyayı duy!",
          "start": 20.17,
          "end": 22.45
        },
        {
          "text": "Kokleada tüy hücreleri dans eder",
          "start": 22.45,
          "end": 26.45
        },
        {
          "text": "Titreşim sinyale, sinyal beyne",
          "start": 26.45,
          "end": 29.88
        },
        {
          "text": "Ses anlam kazanır bir anda",
          "start": 29.88,
          "end": 33.03
        }
      ]
    },
    {
      "label": "Kıta",
      "start": 33.03,
      "end": 48.04,
      "lines": [
        {
          "text": "İnce sesler bir uçta, kalınlar içeride",
          "start": 33.18,
          "end": 37.75
        },
        {
          "text": "Tüy hücreleri bir kez gider, gelmez",
          "start": 37.75,
          "end": 41.46
        },
        {
          "text": "Seksen beş desibel üstü dikkat",
          "start": 41.46,
          "end": 44.89
        },
        {
          "text": "Sesi kıs, kulağını koru",
          "start": 44.89,
          "end": 48.04
        }
      ]
    },
    {
