      "start": 20.02,
      "end": 33.03,
      "lines": [
        {
          "text": "Lub-dub, lub-dub, durmadan atar!",
          "start": 20.17,
          "end": 22.79
        },
        {
          "text": "Kalbim kanı vücuda pompalar",
          "start": 22.79,
          "end": 25.64
        },
        {
          "text": "Atardamar götürür, toplardamar getirir",
          "start": 25.64,
          "end": 29.45
        },
        {
          "text": "Kılcal damarlar ikisini birleştirir",
