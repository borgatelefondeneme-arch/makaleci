    },
    {
      "label": "Kıta",
      "start": 33.03,
      "end": 48.04,
      "lines": [
        {
          "text": "Sol karıncık kanı aorta iter",
          "start": 33.18,
          "end": 37.12
        },
        {
          "text": "Sinüs düğümü sinyali verir",
          "start": 37.12,
          "end": 40.76
        },
        {
          "text": "Koşunca kaslarım oksijen ister",
          "start": 40.76,
          "end": 44.7
        },
        {
          "text": "Kalbim hızlanır, yetiştirir",
          "start": 44.7,
          "end": 48.04
