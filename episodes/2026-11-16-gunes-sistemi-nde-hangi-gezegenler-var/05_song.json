      "start": 20.02,
      "end": 33.03,
      "lines": [
        {
          "text": "Sekiz dünya döner Güneş'in çevresinde!",
          "start": 20.17,
          "end": 23.88
        },
        {
          "text": "Dördü kayalık, dördü dev",
          "start": 23.88,
          "end": 26.35
        },
        {
          "text": "Asteroitler arada kuşak olur",
          "start": 26.35,
          "end": 29.81
        },
        {
          "text": "Plüton cüce, yine de bizden biri",
          "start": 29.81,
          "end": 33.03
        }
      ]
    },
    {
      "label": "Kıta",
      "start": 33.03,
      "end": 48.04,
      "lines": [
        {
          "text": "Jüpiter dev, fırtınası Dünya'dan büyük",
          "start": 33.18,
          "end": 37.16
        },
        {
          "text": "Satürn'ün halkası buz ve kaya",
          "start": 37.16,
          "end": 40.34
        },
        {
          "text": "Uranüs, Neptün uzaklarda buz devi",
          "start": 40.34,
          "end": 44.06
        },
        {
          "text": "Işık dakikalarca yol alır onlara",
          "start": 44.06,
          "end": 48.04
