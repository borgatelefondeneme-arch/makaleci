    },
    {
      "label": "Kıta",
      "start": 33.03,
      "end": 48.04,
      "lines": [
        {
          "text": "Bulut tonlarca ama düşmez yere",
          "start": 33.18,
          "end": 37.04
        },
        {
          "text": "Yükselen hava tutar onu",
          "start": 37.04,
          "end": 40.31
        },
        {
          "text": "Damla yuvarlak, büyüğü yassı",
          "start": 40.31,
          "end": 43.88
        },
        {
          "text": "Toprağa süzülür, akiferde akar",
          "start": 43.88,
          "end": 48.04
