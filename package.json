{
  "name": "gunun-bilimi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Günün Bilimi — bilimsel makaleleri 12 yaş seviyesinde Türkçe animasyonlu videoya çeviren üretim hattı",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "schemas": "tsx schemas/export.ts",
