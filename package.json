    "@fontsource/noto-color-emoji": "^5.3.2",
    "@fontsource/nunito": "^5.3.0",
    "@remotion/bundler": "^4.0.542",
    "@remotion/cli": "^4.0.542",
    "@remotion/renderer": "^4.0.542",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.542",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
