    "select": "tsx pipeline/select/cli.ts",
    "queue": "tsx pipeline/select/queue.ts",
    "script": "tsx pipeline/script/cli.ts",
    "sceneplan": "tsx pipeline/sceneplan/cli.ts",
    "voice": "tsx pipeline/voice/cli.ts",
